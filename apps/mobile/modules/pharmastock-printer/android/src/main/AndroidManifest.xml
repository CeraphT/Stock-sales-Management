<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Classic Bluetooth SPP — legacy manifest-level permissions cover API <= 30. -->
  <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
  <!-- API 31+ requires this as a runtime-requested permission too (requested from Kotlin). -->
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

  <!-- USB Host raw bulk transfer — no manifest permission; grants are per-device via UsbManager at runtime. -->
  <uses-feature android:name="android.hardware.usb.host" android:required="false" />

</manifest>
