# Copy to `.env` (same folder) and fill in real values. NEVER commit .env.
# Generate strong secrets, e.g.:  openssl rand -base64 48

POSTGRES_USER=stockflow
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# JWT signing key — must be long/random (32+ bytes). Rotating it logs everyone out.
JWT_SECRET=CHANGE_ME_64_char_random_string

# One-time secret guarding the super-admin bootstrap endpoint.
BOOTSTRAP_SECRET=CHANGE_ME_random_string
