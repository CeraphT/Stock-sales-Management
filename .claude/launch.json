{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "pharmastock-web"
      ],
      "port": 5174
    },
    {
      "name": "desktop",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "pharmastock-desktop"
      ],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/PharmaStock.Api",
        "--urls",
        "http://localhost:5080"
      ],
      "port": 5080
    },
    {
      "name": "web-testapi",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "pharmastock-web",
        "--",
        "--port",
        "5175"
      ],
      "port": 5175,
      "env": {
        "VITE_API_BASE_URL": "http://localhost:5091"
      }
    }
  ]
}
