@inherits LayoutComponentBase
@inject SuperAdminSession Session
@inject NavigationManager Navigation

<div class="app-shell">
    <header class="app-header">
        <span class="app-brand">PharmaStock <span class="app-brand-accent">SuperAdmin</span></span>
        @if (Session.IsAuthenticated)
        {
            <div class="app-header-user">
                <a class="btn-link" href="/companies">Entreprises</a>
                <a class="btn-link" href="/admins">Administrateurs</a>
                <span>@Session.UserName</span>
                <button class="btn-link" @onclick="SignOut">Se déconnecter</button>
            </div>
        }
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private void SignOut()
    {
        Session.SignOut();
        Navigation.NavigateTo("/login", forceLoad: false);
    }
}
