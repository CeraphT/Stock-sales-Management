<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PharmaStock.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Domain only (not Infrastructure/Api) — same convention as
         PharmaStock.Desktop: reuse shared enums (UserRole, DevicePlatform)
         directly, but declare our own response DTOs matching the Api's
         JSON shape rather than referencing the Api project itself. -->
    <ProjectReference Include="..\PharmaStock.Domain\PharmaStock.Domain.csproj" />
  </ItemGroup>

</Project>
