<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="PharmaStock.Desktop.Controls.Toast"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root"
    InputTransparent="True"
    CascadeInputTransparent="False"
    HorizontalOptions="Fill"
    VerticalOptions="Fill">

    <Border
        x:Name="Bubble"
        IsVisible="False"
        Opacity="0"
        Margin="16,0,16,24"
        Padding="16,12"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 14"
        HorizontalOptions="Center"
        VerticalOptions="End"
        MaximumWidthRequest="480">
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.25" Radius="18" Offset="0,6" />
        </Border.Shadow>
        <Label x:Name="MessageLabel" TextColor="White" FontSize="14" HorizontalTextAlignment="Center" />
    </Border>
</ContentView>
