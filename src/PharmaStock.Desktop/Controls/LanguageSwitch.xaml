<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="PharmaStock.Desktop.Controls.LanguageSwitch"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <!-- A compact FR/EN segmented pill, replacing a native Switch: WinUI's
         ToggleSwitch ignores WidthRequest and keeps ~100px+ of its own
         internal footprint regardless, which stranded the "EN" label far
         from the toggle on Windows. This is fully custom-sized instead, and
         matches the pill look already established by PosPage's payment-
         method chips. -->
    <Border StrokeShape="RoundRectangle 14" StrokeThickness="1" HeightRequest="28" Padding="2"
            Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}">
        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="0">
            <Border x:Name="FrPill" Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,0">
                <Label Text="FR" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFrTapped" />
                </Border.GestureRecognizers>
            </Border>
            <Border x:Name="EnPill" Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,0">
                <Label Text="EN" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEnTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>
    </Border>
</ContentView>
