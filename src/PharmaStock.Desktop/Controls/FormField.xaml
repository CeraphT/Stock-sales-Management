<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="PharmaStock.Desktop.Controls.FormField"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <VerticalStackLayout Spacing="6">
        <Label Text="{Binding Source={x:Reference Root}, Path=Label}" Style="{StaticResource FieldLabel}" />
        <Border Style="{StaticResource FieldBorder}">
            <Entry
                x:Name="EntryControl"
                Placeholder="{Binding Source={x:Reference Root}, Path=Placeholder}"
                IsPassword="{Binding Source={x:Reference Root}, Path=IsPassword}"
                Keyboard="{Binding Source={x:Reference Root}, Path=Keyboard}"
                Text="{Binding Source={x:Reference Root}, Path=Text, Mode=TwoWay}"
                VerticalOptions="Center" />
        </Border>
    </VerticalStackLayout>
</ContentView>
