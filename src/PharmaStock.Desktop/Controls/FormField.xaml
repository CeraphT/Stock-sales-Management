<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="PharmaStock.Desktop.Controls.FormField"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <VerticalStackLayout Spacing="6">
        <Label Text="{Binding Source={x:Reference Root}, Path=Label}" Style="{StaticResource FieldLabel}" />
        <Border Style="{StaticResource FieldBorder}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <Entry
                    Grid.Column="0"
                    x:Name="EntryControl"
                    Placeholder="{Binding Source={x:Reference Root}, Path=Placeholder}"
                    IsPassword="{Binding Source={x:Reference Root}, Path=IsPassword}"
                    Keyboard="{Binding Source={x:Reference Root}, Path=Keyboard}"
                    Text="{Binding Source={x:Reference Root}, Path=Text, Mode=TwoWay}"
                    ReturnType="{Binding Source={x:Reference Root}, Path=ReturnType}"
                    Completed="OnEntryControlCompleted"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    x:Name="ToggleVisibilityLabel"
                    Text="&#xF341;"
                    FontFamily="BootstrapIcons"
                    FontSize="16"
                    VerticalOptions="Center"
                    IsVisible="{Binding Source={x:Reference Root}, Path=IsPassword}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleVisibilityTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentView>
