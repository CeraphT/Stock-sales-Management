<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="PharmaStock.Desktop.Controls.StatTile"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Border Style="{StaticResource Card}" Padding="14">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
        <VerticalStackLayout Spacing="8">
            <Border x:Name="IconBadge" Style="{StaticResource StatTileIconBadge}">
                <Label x:Name="IconLabel" FontFamily="BootstrapIcons" FontSize="20"
                       HorizontalOptions="Center" VerticalOptions="Center"
                       Text="{Binding Source={x:Reference Root}, Path=IconGlyph}" />
            </Border>
            <Label x:Name="ValueLabel" FontSize="22" FontAttributes="Bold" LineBreakMode="TailTruncation"
                   HorizontalOptions="Start" Text="{Binding Source={x:Reference Root}, Path=Value}" />
            <Label Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start"
                   Text="{Binding Source={x:Reference Root}, Path=Label}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
