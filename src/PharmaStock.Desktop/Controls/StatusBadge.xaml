<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="PharmaStock.Desktop.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Border x:Name="PillBorder" Style="{StaticResource StatusPill}">
        <Label FontFamily="OpenSansSemibold" FontSize="11" TextColor="White"
               Text="{Binding Source={x:Reference Root}, Path=Text}" />
    </Border>
</ContentView>
