<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.PosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PharmaStock.Desktop.Controls"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    Title="{loc:Translate Pos_Title}">

    <!-- RowDefinitions/ColumnDefinitions are set in code-behind (ApplyResponsiveLayout)
         based on DeviceInfo.Current.Idiom — phone stacks MainColumnGrid above
         FooterPanel (single column, matches every other page in the app);
         tablet places them side by side so the payment/checkout panel stays
         visible without scrolling past a long cart. Same two controls either
         way, just reparented into different Grid.Row/Column slots, so there's
         only ever one instance of each named element. -->
    <Grid x:Name="RootLayoutGrid" Padding="16" RowSpacing="12" ColumnSpacing="16">

      <Grid x:Name="MainColumnGrid" RowDefinitions="Auto,*" RowSpacing="12">

        <!-- Header: fixed, never scrolls -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="{loc:Translate Pos_Title}" Style="{StaticResource PageTitle}" HorizontalOptions="Start" />

            <!-- Barcode entry (also accepts BT/USB scanner keystrokes) + camera scan -->
            <Border Style="{StaticResource FieldBorder}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry x:Name="BarcodeEntry" Grid.Column="0" Placeholder="{loc:Translate Pos_BarcodePlaceholder}"
                           ReturnType="Done" Completed="OnBarcodeEntryCompleted" />
                    <controls:IconButton x:Name="ScanButton" Grid.Column="1" Icon="{x:Static loc:BootstrapIcons.UpcScan}" Text="{loc:Translate Pos_ScanButton}" Clicked="OnScanClicked" />
                </Grid>
            </Border>

            <controls:CollapsibleSearchBar x:Name="ProductSearchBar" Placeholder="{loc:Translate Pos_SearchPlaceholder}" TextChanged="OnSearchTextChanged" />
            <ActivityIndicator x:Name="SearchSpinner" IsRunning="False" IsVisible="False" />
            <CollectionView x:Name="SearchResultsView" SelectionMode="Single" SelectionChanged="OnSearchResultSelected"
                             IsVisible="False" MaximumHeightRequest="240">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FieldBorder}" HeightRequest="-1" Padding="12,8" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Border BackgroundColor="{Binding StatusColor}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,2" HorizontalOptions="Start">
                                        <Label Text="{Binding StatusText}" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                    </Border>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding PriceText}" VerticalOptions="Center" FontAttributes="Bold" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />
        </VerticalStackLayout>

        <!-- Cart: the only region that scrolls, fills whatever space is left between header and footer -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="8">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="{loc:Translate Pos_Cart}" Style="{StaticResource SectionLabel}" VerticalOptions="Center" />
                <controls:IconButton Grid.Column="1" x:Name="HoldButton" Icon="{x:Static loc:BootstrapIcons.PauseCircle}" Text="{loc:Translate Pos_HoldAction}" Variant="Secondary"
                        Clicked="OnHoldClicked" IsEnabled="False" />
                <controls:IconButton Grid.Column="2" x:Name="ResumeButton" Icon="{x:Static loc:BootstrapIcons.ClipboardCheck}" Text="{loc:Translate Pos_ResumeAction}" Variant="Secondary"
                        Clicked="OnResumeClicked" />
            </Grid>
            <Label Grid.Row="1" x:Name="EmptyCartLabel" Text="{loc:Translate Pos_EmptyCart}"
                   Style="{StaticResource PageSubtitle}" VerticalOptions="Start" HorizontalTextAlignment="Start" />
            <CollectionView Grid.Row="1" x:Name="CartView" IsVisible="False">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FieldBorder}" HeightRequest="-1" Padding="12,10" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Button Grid.Row="0" Grid.Column="1" Text="&#xF5DE;" FontFamily="BootstrapIcons" Style="{StaticResource SecondaryButton}"
                                        Padding="0" WidthRequest="46" Clicked="OnRemoveLineClicked" CommandParameter="{Binding .}" />

                                <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="10" VerticalOptions="Center">
                                    <Label Text="{Binding UnitLabel}" Style="{StaticResource PageSubtitle}" VerticalOptions="Center" />
                                    <Button Text="-" WidthRequest="36" HeightRequest="36" CornerRadius="18" Padding="0" Clicked="OnDecreaseQuantityClicked" CommandParameter="{Binding .}" />
                                    <Label Text="{Binding Quantity}" VerticalOptions="Center" WidthRequest="24" HorizontalTextAlignment="Center" FontAttributes="Bold" />
                                    <Button Text="+" WidthRequest="36" HeightRequest="36" CornerRadius="18" Padding="0" Clicked="OnIncreaseQuantityClicked" CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding LineTotalText}" VerticalOptions="Center" FontAttributes="Bold" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

      </Grid>

        <!-- Footer: fixed, always visible regardless of cart length. Elevated as
             its own card (reusing the Card style, padding tightened) so the
             commit action visually separates from the scrolling cart above it. -->
        <Border x:Name="FooterPanel" Style="{StaticResource Card}" Padding="16">
            <VerticalStackLayout Spacing="10">
                <Label Text="{loc:Translate Pos_PaymentMethod}" Style="{StaticResource SectionLabel}" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Button x:Name="CashChip" Grid.Column="0" Text="{loc:Translate Pos_Cash}" Style="{StaticResource ChipButtonSelected}" Clicked="OnCashChipClicked" />
                    <Button x:Name="MobileMoneyChip" Grid.Column="1" Text="{loc:Translate Pos_MobileMoney}" Style="{StaticResource ChipButtonUnselected}" Clicked="OnMobileMoneyChipClicked" />
                    <Button x:Name="SplitChip" Grid.Column="2" Text="{loc:Translate Pos_Split}" Style="{StaticResource ChipButtonUnselected}" Clicked="OnSplitChipClicked" />
                </Grid>

                <!-- Split mode only: cash + mobile money amounts, must sum to the cart total. -->
                <VerticalStackLayout x:Name="SplitPaymentDetail" IsVisible="False" Spacing="8">
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry x:Name="SplitCashEntry" Placeholder="{loc:Translate Pos_SplitCashAmountPlaceholder}" Keyboard="Numeric" TextChanged="OnSplitCashTextChanged" />
                    </Border>
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry x:Name="SplitMobileMoneyEntry" Placeholder="{loc:Translate Pos_SplitMobileMoneyAmountPlaceholder}" Keyboard="Numeric" TextChanged="OnSplitMobileMoneyTextChanged" />
                    </Border>
                    <Label x:Name="SplitHintLabel" Style="{StaticResource PageSubtitle}" />
                </VerticalStackLayout>

                <!-- Cash mode, and the cash leg of Split mode: optional amount tendered
                     with live change-due — blank means "exact amount, no change". -->
                <VerticalStackLayout x:Name="TenderedDetail" IsVisible="False" Spacing="6">
                    <Label Text="{loc:Translate Pos_TenderedLabel}" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry x:Name="TenderedEntry" Placeholder="{loc:Translate Pos_TenderedPlaceholder}" Keyboard="Numeric" TextChanged="OnTenderedTextChanged" />
                    </Border>
                    <Label x:Name="ChangeDueLabel" Style="{StaticResource PageSubtitle}" IsVisible="False" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{loc:Translate Pos_Total}" Style="{StaticResource SectionLabel}" VerticalOptions="Center" />
                    <Label Grid.Column="1" x:Name="TotalLabel" Text="0" FontSize="24" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </Grid>

                <controls:IconButton x:Name="CheckoutButton" Icon="{x:Static loc:BootstrapIcons.Check2}" Text="{loc:Translate Pos_Checkout}" HeightRequest="52" Clicked="OnCheckoutClicked" IsEnabled="False" />
                <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
