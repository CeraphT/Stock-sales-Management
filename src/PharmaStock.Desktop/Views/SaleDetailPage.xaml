<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.SaleDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    xmlns:controls="clr-namespace:PharmaStock.Desktop.Controls"
    Title="{loc:Translate SaleDetail_Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="PrintToolbarItem" Clicked="OnPrintClicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="BootstrapIcons" Glyph="&#xF501;" Size="20">
                    <FontImageSource.Color>
                        <AppThemeBinding Light="{StaticResource Black}" Dark="{StaticResource SecondaryDarkText}" />
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid>
    <ScrollView x:Name="ContentScroll">
        <VerticalStackLayout Padding="16" Spacing="16">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="CompanyNameLabel" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Label x:Name="LocationLabel" Style="{StaticResource PageSubtitle}" />
                    <Label x:Name="TimestampLabel" Style="{StaticResource PageSubtitle}" />
                    <Label x:Name="CashierLabel" Style="{StaticResource PageSubtitle}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:Translate SaleDetail_Articles}" Style="{StaticResource SectionLabel}" />
            <CollectionView x:Name="LinesView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FieldBorder}" HeightRequest="-1" Padding="12,8" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding DetailText}" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding AmountText}" VerticalOptions="Center" FontAttributes="Bold" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Dashed rule (StrokeDashArray on a zero-height Border) for an
                 authentic torn-receipt feel, in place of a plain solid line. -->
            <Border HeightRequest="1" StrokeThickness="1" StrokeDashArray="4,3" Stroke="{StaticResource BorderColor}" HorizontalOptions="Fill" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{loc:Translate Pos_Total}" Style="{StaticResource SectionLabel}" VerticalOptions="Center" />
                <Label Grid.Column="1" x:Name="TotalLabel" Text="0" FontSize="24" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            </Grid>
            <controls:StatusBadge x:Name="PaymentBadge" HorizontalOptions="Start" />

            <Label x:Name="PaymentBreakdownLabel" Text="{loc:Translate SaleDetail_PaymentBreakdown}" Style="{StaticResource SectionLabel}" IsVisible="False" />
            <CollectionView x:Name="PaymentSplitsView" IsVisible="False">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                            <Label Grid.Column="0" Text="{Binding MethodText}" Style="{StaticResource PageSubtitle}" />
                            <Label Grid.Column="1" Text="{Binding AmountText}" FontAttributes="Bold" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="TenderedLabel" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" IsVisible="False" />
            <Label x:Name="ChangeDueLabel" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>

    <ActivityIndicator x:Name="LoadingSpinner" IsRunning="False" IsVisible="False" />
    </Grid>
</ContentPage>
