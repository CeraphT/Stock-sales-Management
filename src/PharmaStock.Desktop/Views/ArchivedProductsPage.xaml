<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.ArchivedProductsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    xmlns:controls="clr-namespace:PharmaStock.Desktop.Controls"
    Title="{loc:Translate Shell_Archives}">

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="{loc:Translate Archived_Title}" Style="{StaticResource PageTitle}" HorizontalOptions="Start" />
            <Label Text="{loc:Translate Archived_Subtitle}" Style="{StaticResource PageSubtitle}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" RowDefinitions="*,Auto" RowSpacing="8">
            <CollectionView Grid.Row="0" x:Name="ProductsView" SelectionMode="Single" SelectionChanged="OnProductSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,6">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding SubtitleText}" Style="{StaticResource PageSubtitle}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding PriceText}" VerticalOptions="Center" FontAttributes="Bold" />
                                <Button Grid.Column="2" Text="&#xF117;" FontFamily="BootstrapIcons" Style="{StaticResource SecondaryButton}"
                                        Padding="0" WidthRequest="46" Clicked="OnRestoreClicked" CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Grid.Row="0" x:Name="EmptyLabel" Text="{loc:Translate Archived_NoProducts}" Style="{StaticResource PageSubtitle}" IsVisible="False" VerticalOptions="Start" />

            <ActivityIndicator Grid.Row="0" x:Name="LoadingSpinner" IsRunning="False" IsVisible="False" VerticalOptions="Start" Margin="0,24,0,0" />

            <controls:IconButton Grid.Row="1" x:Name="LoadMoreButton" Icon="{x:Static loc:BootstrapIcons.ChevronDown}" Text="{loc:Translate Common_LoadMore}" Variant="Secondary" Clicked="OnLoadMoreClicked" IsVisible="False" />
        </Grid>

    </Grid>
</ContentPage>
