<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.JoinCompanyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PharmaStock.Desktop.Controls"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    Title="{loc:Translate JoinCompany_Title}">

    <ScrollView>
        <Grid Padding="24">
            <Border Style="{StaticResource Card}" MaximumWidthRequest="420" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{loc:Translate JoinCompany_Heading}" Style="{StaticResource PageTitle}" />
                    <Label Text="{loc:Translate JoinCompany_Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,0,0,6" />

                    <controls:FormField x:Name="CodeField" Label="{loc:Translate JoinCompany_CodeLabel}" Placeholder="ex. PHRM-7X2K9" ReturnType="Search" Completed="OnFindClicked" />
                    <controls:IconButton x:Name="FindButton" Icon="{x:Static loc:BootstrapIcons.Search}" Text="{loc:Translate JoinCompany_Find}" Clicked="OnFindClicked" Margin="0,6,0,0" />

                    <Border x:Name="ResultCard" IsVisible="False" BackgroundColor="{AppThemeBinding Light=#EAF6F1, Dark=#123027}"
                            Stroke="{StaticResource SuccessColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="14" Margin="0,6,0,0">
                        <Label x:Name="ResultLabel" TextColor="{StaticResource SuccessColor}" FontAttributes="Bold" />
                    </Border>
                    <controls:IconButton x:Name="ContinueButton" Icon="{x:Static loc:BootstrapIcons.ArrowRight}" Text="{loc:Translate JoinCompany_Continue}" IsVisible="False" Clicked="OnContinueClicked" />

                    <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
