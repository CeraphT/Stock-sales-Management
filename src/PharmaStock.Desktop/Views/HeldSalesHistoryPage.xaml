<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.HeldSalesHistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    Title="{loc:Translate Shell_HeldSales}">

    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label Grid.Column="0" Text="{loc:Translate Shell_HeldSales}" Style="{StaticResource PageTitle}" HorizontalOptions="Start" VerticalOptions="Center" />
            <Button Grid.Column="1" x:Name="ExportButton" Text="&#xF30A;" FontFamily="BootstrapIcons" Style="{StaticResource SecondaryButton}" FontSize="18" Padding="0" WidthRequest="46" HeightRequest="46" Clicked="OnExportClicked" SemanticProperties.Hint="{loc:Translate HeldSalesHistory_Export}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,Auto" ColumnSpacing="6">
            <Button Grid.Column="0" x:Name="TodayChip" Text="{loc:Translate SalesHistory_Today}" Style="{StaticResource ChipButtonUnselected}" FontSize="12" Padding="4,10" Clicked="OnTodayClicked" />
            <Button Grid.Column="1" x:Name="Last7Chip" Text="{loc:Translate SalesHistory_Last7Days}" Style="{StaticResource ChipButtonUnselected}" FontSize="12" Padding="4,10" Clicked="OnLast7Clicked" />
            <Button Grid.Column="2" x:Name="Last30Chip" Text="{loc:Translate SalesHistory_Last30Days}" Style="{StaticResource ChipButtonUnselected}" FontSize="12" Padding="4,10" Clicked="OnLast30Clicked" />
            <Button Grid.Column="3" x:Name="AllChip" Text="{loc:Translate SalesHistory_All}" Style="{StaticResource ChipButtonSelected}" FontSize="12" Padding="4,10" Clicked="OnAllClicked" />
            <Button Grid.Column="4" x:Name="CustomRangeToggle" Text="&#xF214;" FontFamily="BootstrapIcons" Style="{StaticResource SecondaryButton}" Padding="0" WidthRequest="46" Clicked="OnCustomRangeToggleClicked" />
        </Grid>

        <Grid Grid.Row="2" x:Name="CustomRangeRow" ColumnDefinitions="*,*,Auto" ColumnSpacing="8" IsVisible="False">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="{loc:Translate SalesHistory_From}" Style="{StaticResource FieldLabel}" />
                <DatePicker x:Name="FromDatePicker" Format="dd/MM/yyyy" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label Text="{loc:Translate SalesHistory_To}" Style="{StaticResource FieldLabel}" />
                <DatePicker x:Name="ToDatePicker" Format="dd/MM/yyyy" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="&#xF272;" FontFamily="BootstrapIcons" VerticalOptions="End" WidthRequest="46" Clicked="OnApplyCustomRangeClicked" />
        </Grid>

        <Grid Grid.Row="3">
            <CollectionView x:Name="HeldSalesView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,6">
                            <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="0">
                                <BoxView Grid.Column="0" Color="{StaticResource AccentAmber}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="4" Padding="14,12">
                                    <Label Text="{Binding TimeText}" FontAttributes="Bold" />
                                    <Label Text="{Binding SubtitleText}" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="&#xF5DE;" FontFamily="BootstrapIcons" Style="{StaticResource SecondaryButton}"
                                        Padding="0" WidthRequest="46" VerticalOptions="Center" Margin="0,0,10,0"
                                        Clicked="OnDeleteHeldSaleClicked" CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="EmptyLabel" Text="{loc:Translate HeldSalesHistory_Empty}" Style="{StaticResource PageSubtitle}" IsVisible="False" VerticalOptions="Start" />

            <ActivityIndicator x:Name="LoadingSpinner" IsRunning="False" IsVisible="False" VerticalOptions="Start" Margin="0,24,0,0" />
        </Grid>

    </Grid>
</ContentPage>
