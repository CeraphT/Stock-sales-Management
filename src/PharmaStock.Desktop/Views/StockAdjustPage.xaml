<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.StockAdjustPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PharmaStock.Desktop.Controls"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    xmlns:toolkit="http://schemas.syncfusion.com/maui/toolkit"
    Title="{loc:Translate StockAdjust_Title}">

    <ScrollView>
        <Grid Padding="24">
            <Border Style="{StaticResource Card}" MaximumWidthRequest="480" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{loc:Translate StockAdjust_Title}" Style="{StaticResource PageTitle}" />
                    <Label x:Name="ProductNameLabel" Style="{StaticResource PageSubtitle}" Margin="0,0,0,6" />

                    <Label Text="{loc:Translate StockAdjust_BatchLabel}" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Picker x:Name="BatchPicker" Title="{loc:Translate StockAdjust_BatchPickerTitle}" />
                    </Border>

                    <!-- SfNumericEntry (no Minimum set, so negatives are allowed) replaces a
                         plain-keyboard Entry: the old native numeric keypad couldn't reliably
                         offer a typeable minus sign on Android for a negative delta. -->
                    <Label Text="{loc:Translate StockAdjust_DeltaLabel}" Style="{StaticResource FieldLabel}" />
                    <toolkit:SfNumericEntry x:Name="DeltaEntry" HeightRequest="46" />
                    <controls:FormField x:Name="ReasonField" Label="{loc:Translate StockAdjust_ReasonLabel}" Placeholder="{loc:Translate StockAdjust_ReasonPlaceholder}" />

                    <controls:IconButton x:Name="SaveButton" Icon="{x:Static loc:BootstrapIcons.Check2}" Text="{loc:Translate StockAdjust_Save}" Clicked="OnSaveClicked" Margin="0,10,0,0" />
                    <controls:IconButton Icon="{x:Static loc:BootstrapIcons.ArrowLeft}" Text="{loc:Translate Common_BackToPage}" Variant="Secondary" Clicked="OnBackClicked" />
                    <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
