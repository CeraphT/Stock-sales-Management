<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.PurchaseOrderDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    xmlns:controls="clr-namespace:PharmaStock.Desktop.Controls"
    Title="{loc:Translate PurchaseOrder_DetailTitle}">

    <Grid>
        <ScrollView x:Name="ContentScroll">
            <VerticalStackLayout Padding="16" Spacing="14">

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" x:Name="SupplierLabel" Style="{StaticResource PageTitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" VerticalOptions="Center" />
                    <Button Grid.Column="1" x:Name="ShareButton" Text="&#xF52E;" FontFamily="BootstrapIcons" Style="{StaticResource SecondaryButton}" FontSize="18" Padding="0" WidthRequest="46" HeightRequest="46" Clicked="OnShareClicked" SemanticProperties.Hint="{loc:Translate PurchaseOrder_Share}" />
                </Grid>
                <Label x:Name="HeaderSubtitleLabel" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                <Label x:Name="StatusLabel" FontAttributes="Bold" HorizontalOptions="Start" />
                <Label x:Name="NotesLabel" Style="{StaticResource PageSubtitle}" IsVisible="False" HorizontalOptions="Start" HorizontalTextAlignment="Start" />

                <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />

                <Label Text="{loc:Translate PurchaseOrder_Lines}" Style="{StaticResource SectionLabel}" />
                <CollectionView x:Name="LinesView">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,6">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding ProductName}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <controls:IconButton Grid.Row="0" Grid.Column="1" Icon="{x:Static loc:BootstrapIcons.ClipboardCheck}" Text="{loc:Translate PurchaseOrder_ReceiveAction}" Variant="Secondary"
                                            Clicked="OnReceiveLineClicked" CommandParameter="{Binding .}" IsVisible="{Binding CanReceive}" />
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding SubtitleText}" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <controls:IconButton x:Name="CancelOrderButton" Icon="{x:Static loc:BootstrapIcons.XLg}" Text="{loc:Translate PurchaseOrder_CancelOrder}" Variant="Secondary"
                        TextColorOverride="{StaticResource ErrorColor}" Clicked="OnCancelOrderClicked" IsVisible="False" Margin="0,10,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator x:Name="LoadingSpinner" IsRunning="False" IsVisible="False" VerticalOptions="Start" Margin="0,40,0,0" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
