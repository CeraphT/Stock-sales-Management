<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Welcome">

    <VerticalStackLayout Padding="40" Spacing="20" VerticalOptions="Center" MaximumWidthRequest="420" HorizontalOptions="Center">
        <Label Text="PharmaStock" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label Text="Stock &amp; sales management for your pharmacy" FontSize="14" HorizontalOptions="Center" TextColor="Gray" />

        <Button Text="Create a New Company" Clicked="OnCreateCompanyClicked" Margin="0,20,0,0" />
        <Button Text="Join an Existing Company" Clicked="OnJoinCompanyClicked" />
        <Button Text="Log In" Clicked="OnLoginClicked" />
    </VerticalStackLayout>
</ContentPage>
