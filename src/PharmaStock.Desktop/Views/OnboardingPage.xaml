<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    xmlns:controls="clr-namespace:PharmaStock.Desktop.Controls"
    Title="Bienvenue"
    Shell.NavBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled">

    <ScrollView>
        <Grid Padding="24">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource OffBlack}}" Offset="0.0" />
                    <GradientStop Color="{AppThemeBinding Light={StaticResource AccentBlueSoft}, Dark={StaticResource Gray950}}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Border Style="{StaticResource Card}" MaximumWidthRequest="420" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="10">
                    <Image Source="pharmastock_logo_full.svg" WidthRequest="280" HeightRequest="91" Aspect="AspectFit" HorizontalOptions="Center" />

                    <Label Text="{loc:Translate Onboarding_Subtitle}" Style="{StaticResource PageSubtitle}" HorizontalTextAlignment="Center" Margin="0,0,0,10" />

                    <controls:IconButton Icon="{x:Static loc:BootstrapIcons.PlusLg}" Text="{loc:Translate Onboarding_CreateCompany}" Clicked="OnCreateCompanyClicked" Margin="0,14,0,0" />
                    <controls:IconButton Icon="{x:Static loc:BootstrapIcons.ArrowRight}" Text="{loc:Translate Onboarding_JoinCompany}" Variant="Secondary" Clicked="OnJoinCompanyClicked" />
                    <controls:IconButton Icon="{x:Static loc:BootstrapIcons.ArrowRight}" Text="{loc:Translate Onboarding_Login}" Variant="Secondary" Clicked="OnLoginClicked" />

                    <!-- Windows gets this in the app-wide Window.TitleBar instead
                         (see App.xaml.cs) — Android has no TitleBar equivalent
                         and keeps it here as before. -->
                    <controls:LanguageSwitch HorizontalOptions="Center" Margin="0,10,0,0" IsVisible="{OnPlatform Default=True, WinUI=False}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
