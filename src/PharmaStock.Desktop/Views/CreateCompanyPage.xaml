<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.CreateCompanyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PharmaStock.Desktop.Controls"
    Title="Create a Company">

    <ScrollView>
        <Grid Padding="24">
            <Border Style="{StaticResource Card}" MaximumWidthRequest="480" HorizontalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Create your company" Style="{StaticResource PageTitle}" />
                    <Label Text="This sets up your pharmacy and your own admin account." Style="{StaticResource PageSubtitle}" Margin="0,0,0,6" />

                    <Label Text="COMPANY" Style="{StaticResource SectionLabel}" Margin="0,10,0,0" />
                    <controls:FormField x:Name="NameField" Label="NAME" Placeholder="e.g. Pharmacie Centrale" />
                    <controls:FormField x:Name="DescriptionField" Label="DESCRIPTION (OPTIONAL)" Placeholder="A short description" />
                    <controls:FormField x:Name="CurrencyField" Label="CURRENCY" Placeholder="XAF" Text="XAF" />

                    <Label Text="YOUR ADMIN ACCOUNT" Style="{StaticResource SectionLabel}" Margin="0,10,0,0" />
                    <controls:FormField x:Name="AdminNameField" Label="YOUR NAME" Placeholder="e.g. Aline Mballa" />
                    <controls:FormField x:Name="AdminPhoneField" Label="PHONE NUMBER" Placeholder="e.g. 677001122" Keyboard="Telephone" />
                    <controls:FormField x:Name="AdminPasswordField" Label="PASSWORD" Placeholder="Min. 6 characters" IsPassword="True" />

                    <Label x:Name="ErrorLabel" Style="{StaticResource ErrorText}" IsVisible="False" Margin="0,6,0,0" />

                    <Button x:Name="SubmitButton" Text="Create Company" Clicked="OnSubmitClicked" Margin="0,14,0,0" />
                    <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
