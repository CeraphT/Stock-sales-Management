<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.CreateCompanyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Create a Company">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="12" MaximumWidthRequest="480" HorizontalOptions="Center">
            <Label Text="Company" FontAttributes="Bold" FontSize="18" />
            <Entry x:Name="NameEntry" Placeholder="Company name (e.g. Pharmacie Centrale)" />
            <Entry x:Name="DescriptionEntry" Placeholder="Description (optional)" />
            <Entry x:Name="CurrencyEntry" Placeholder="Currency" Text="XAF" />

            <Label Text="Your admin account" FontAttributes="Bold" FontSize="18" Margin="0,20,0,0" />
            <Entry x:Name="AdminNameEntry" Placeholder="Your name" />
            <Entry x:Name="AdminPhoneEntry" Placeholder="Phone number" Keyboard="Telephone" />
            <Entry x:Name="AdminPasswordEntry" Placeholder="Password (min 6 characters)" IsPassword="True" />

            <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" Margin="0,10,0,0" />

            <Button x:Name="SubmitButton" Text="Create Company" Clicked="OnSubmitClicked" Margin="0,20,0,0" />
            <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
