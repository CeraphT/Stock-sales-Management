<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.BarcodeScannerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    xmlns:controls="clr-namespace:PharmaStock.Desktop.Controls"
    Title="{loc:Translate Scanner_Title}"
    BackgroundColor="Black">

    <Grid>
        <zxing:CameraBarcodeReaderView
            x:Name="BarcodeReader"
            BarcodesDetected="OnBarcodesDetected" />

        <Border Style="{StaticResource Card}" VerticalOptions="End" HorizontalOptions="Fill" Margin="16">
            <VerticalStackLayout Spacing="10">
                <Label Text="{loc:Translate Scanner_Instruction}" Style="{StaticResource PageSubtitle}" />
                <controls:IconButton Icon="{x:Static loc:BootstrapIcons.XLg}" Text="{loc:Translate Common_Cancel}" Variant="Secondary" Clicked="OnCancelClicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
