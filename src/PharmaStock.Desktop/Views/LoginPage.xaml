<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PharmaStock.Desktop.Controls"
    Title="Log In">

    <Grid Padding="24">
        <Border Style="{StaticResource Card}" MaximumWidthRequest="420" HorizontalOptions="Center" VerticalOptions="Center">
            <VerticalStackLayout Spacing="14">
                <Label Text="Log in" Style="{StaticResource PageTitle}" />
                <Label Text="Use your phone number and password." Style="{StaticResource PageSubtitle}" Margin="0,0,0,6" />

                <controls:FormField x:Name="PhoneField" Label="PHONE NUMBER" Placeholder="e.g. 677001122" Keyboard="Telephone" />
                <controls:FormField x:Name="PasswordField" Label="PASSWORD" Placeholder="Your password" IsPassword="True" />

                <Label x:Name="ErrorLabel" Style="{StaticResource ErrorText}" IsVisible="False" />

                <Button x:Name="SubmitButton" Text="Log In" Clicked="OnSubmitClicked" Margin="0,10,0,0" />
                <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
