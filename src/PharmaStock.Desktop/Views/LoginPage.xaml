<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PharmaStock.Desktop.Controls"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    Title="{loc:Translate Login_Title}"
    Shell.FlyoutBehavior="Disabled">

    <ScrollView>
        <Grid Padding="24">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource OffBlack}}" Offset="0.0" />
                    <GradientStop Color="{AppThemeBinding Light={StaticResource AccentBlueSoft}, Dark={StaticResource Gray950}}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Border Style="{StaticResource Card}" MaximumWidthRequest="420" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{loc:Translate Login_Title}" Style="{StaticResource PageTitle}" />
                    <Label Text="{loc:Translate Login_Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,0,0,6" />

                    <controls:FormField x:Name="PhoneField" Label="{loc:Translate Login_PhoneLabel}" Placeholder="ex. 677001122" Keyboard="Telephone" ReturnType="Next" Completed="OnPhoneFieldCompleted" />
                    <controls:FormField x:Name="PasswordField" Label="{loc:Translate Login_PasswordLabel}" Placeholder="{loc:Translate Login_PasswordPlaceholder}" IsPassword="True" ReturnType="Done" Completed="OnSubmitClicked" />

                    <controls:IconButton x:Name="SubmitButton" Icon="{x:Static loc:BootstrapIcons.Key}" Text="{loc:Translate Login_Submit}" Clicked="OnSubmitClicked" Margin="0,10,0,0" />
                    <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />

                    <!-- Windows gets this in the app-wide Window.TitleBar instead
                         (see App.xaml.cs) — Android has no TitleBar equivalent
                         and keeps it here as before. -->
                    <controls:LanguageSwitch HorizontalOptions="Center" Margin="0,6,0,0" IsVisible="{OnPlatform Default=True, WinUI=False}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
