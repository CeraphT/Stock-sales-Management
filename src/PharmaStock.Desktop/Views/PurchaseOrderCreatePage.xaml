<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.PurchaseOrderCreatePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PharmaStock.Desktop.Controls"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    Title="{loc:Translate PurchaseOrder_New}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{loc:Translate PurchaseOrder_New}" Style="{StaticResource PageTitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />

            <Label Text="{loc:Translate PurchaseOrder_SupplierLabel}" Style="{StaticResource SectionLabel}" />
            <Button x:Name="SupplierButton" Text="{loc:Translate PurchaseOrder_SupplierPlaceholder}" Style="{StaticResource SecondaryButton}" HorizontalOptions="Fill" Clicked="OnSupplierClicked" />

            <VerticalStackLayout x:Name="RestockSuggestionsSection" Spacing="8" IsVisible="False">
                <Label Text="{loc:Translate PurchaseOrder_RestockSuggestions}" Style="{StaticResource SectionLabel}" />
                <ActivityIndicator x:Name="RestockSpinner" IsRunning="False" IsVisible="False" />
                <Label x:Name="NoRestockSuggestionsLabel" Text="{loc:Translate PurchaseOrder_NoRestockSuggestions}" Style="{StaticResource PageSubtitle}" IsVisible="False" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                <CollectionView x:Name="RestockSuggestionsView" IsVisible="False" MaximumHeightRequest="280">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FieldBorder}" HeightRequest="-1" Padding="12,8" Margin="0,4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding SubtitleText}" Style="{StaticResource PageSubtitle}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="&#xF64D;" FontFamily="BootstrapIcons" WidthRequest="46" Padding="0" Clicked="OnAddRestockSuggestionClicked" CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <controls:FormField x:Name="NotesField" Label="{loc:Translate PurchaseOrder_NotesLabel}" Placeholder="{loc:Translate PurchaseOrder_NotesPlaceholder}" />

            <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />

            <Label Text="{loc:Translate PurchaseOrder_AddProducts}" Style="{StaticResource SectionLabel}" />
            <controls:CollapsibleSearchBar x:Name="ProductSearchBar" Placeholder="{loc:Translate Pos_SearchPlaceholder}" TextChanged="OnSearchTextChanged" />
            <ActivityIndicator x:Name="SearchSpinner" IsRunning="False" IsVisible="False" />
            <CollectionView x:Name="SearchResultsView" SelectionMode="Single" SelectionChanged="OnSearchResultSelected" IsVisible="False" MaximumHeightRequest="240">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FieldBorder}" HeightRequest="-1" Padding="12,8" Margin="0,4">
                            <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{loc:Translate PurchaseOrder_Lines}" Style="{StaticResource SectionLabel}" />
            <Label x:Name="NoLinesLabel" Text="{loc:Translate PurchaseOrder_NoLines}" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
            <CollectionView x:Name="LinesView" IsVisible="False">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FieldBorder}" HeightRequest="-1" Padding="12,10" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding ProductName}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Button Grid.Row="0" Grid.Column="1" Text="&#xF5DE;" FontFamily="BootstrapIcons" Style="{StaticResource SecondaryButton}"
                                        Padding="0" WidthRequest="46" Clicked="OnRemoveLineClicked" CommandParameter="{Binding .}" />

                                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,90,Auto,110" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{loc:Translate PurchaseOrder_QuantityLabel}" Style="{StaticResource PageSubtitle}" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Text="{Binding QuantityText, Mode=OneWay}" Keyboard="Numeric" TextChanged="OnLineQuantityChanged" />
                                    <Label Grid.Column="2" Text="{loc:Translate PurchaseOrder_UnitCostLabel}" Style="{StaticResource PageSubtitle}" VerticalOptions="Center" />
                                    <Entry Grid.Column="3" Text="{Binding UnitCostText, Mode=OneWay}" Keyboard="Numeric" TextChanged="OnLineUnitCostChanged" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <controls:IconButton x:Name="SubmitButton" Icon="{x:Static loc:BootstrapIcons.Check2}" Text="{loc:Translate PurchaseOrder_Submit}" HeightRequest="52" Clicked="OnSubmitClicked" IsEnabled="False" Margin="0,10,0,0" />
            <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
