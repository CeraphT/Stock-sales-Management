<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.PrinterSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    xmlns:controls="clr-namespace:PharmaStock.Desktop.Controls"
    Title="{loc:Translate Shell_PrinterSettings}">

    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="12">

        <Label Grid.Row="0" Text="{loc:Translate Printer_PageTitle}" Style="{StaticResource PageTitle}" HorizontalOptions="Start" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
            <Label x:Name="SelectedPrinterLabel" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label Grid.Column="0" Text="{loc:Translate Printer_AvailableDevices}" Style="{StaticResource SectionLabel}" VerticalOptions="Center" />
            <Button Grid.Column="1" x:Name="RefreshButton" Text="&#xF116;" FontFamily="BootstrapIcons" Style="{StaticResource SecondaryButton}" Padding="0" WidthRequest="46" Clicked="OnRefreshClicked" />
        </Grid>

        <Grid Grid.Row="3" RowDefinitions="*">
            <CollectionView Grid.Row="0" x:Name="DevicesView" SelectionMode="Single" SelectionChanged="OnDeviceSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,6">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding SubtitleText}" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Grid.Row="0" x:Name="EmptyLabel" Style="{StaticResource PageSubtitle}" IsVisible="False" VerticalOptions="Start" HorizontalOptions="Start" HorizontalTextAlignment="Start"
                   Text="{loc:Translate Printer_NoDevicesFound}" />

            <ActivityIndicator Grid.Row="0" x:Name="LoadingSpinner" IsRunning="False" IsVisible="False" VerticalOptions="Start" Margin="0,24,0,0" />
        </Grid>

        <controls:IconButton Grid.Row="4" x:Name="PairBluetoothButton" Icon="{x:Static loc:BootstrapIcons.Bluetooth}" Text="{loc:Translate Printer_PairBluetooth}" Variant="Secondary" Clicked="OnPairBluetoothClicked" IsVisible="False" />

        <controls:IconButton Grid.Row="5" x:Name="TestPrintButton" Icon="{x:Static loc:BootstrapIcons.Printer}" Text="{loc:Translate Printer_PrintTestPage}" Clicked="OnTestPrintClicked" IsEnabled="False" />

    </Grid>
</ContentPage>
