<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    xmlns:controls="clr-namespace:PharmaStock.Desktop.Controls"
    xmlns:toolkit="http://schemas.syncfusion.com/maui/toolkit"
    Title="{loc:Translate Dashboard_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <VerticalStackLayout Spacing="2">
                <Label Text="{loc:Translate Dashboard_Title}" Style="{StaticResource PageTitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                <Label x:Name="WelcomeLabel" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
            </VerticalStackLayout>

            <ActivityIndicator x:Name="LoadingSpinner" IsRunning="False" IsVisible="False" HorizontalOptions="Center" Margin="0,40,0,0" />

            <VerticalStackLayout x:Name="ContentStack" Spacing="16">

            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <controls:StatTile Grid.Row="0" Grid.Column="0" x:Name="RevenueTodayTile"
                        IconGlyph="{x:Static loc:BootstrapIcons.CashCoin}"
                        AccentColor="{StaticResource SuccessColor}" AccentSoftColor="#DCFCE7"
                        Label="{loc:Translate Dashboard_RevenueToday}" />
                <controls:StatTile Grid.Row="0" Grid.Column="1" x:Name="SalesTodayTile"
                        IconGlyph="{x:Static loc:BootstrapIcons.Cart3}"
                        AccentColor="{StaticResource AccentBlue}" AccentSoftColor="{StaticResource AccentBlueSoft}"
                        Label="{loc:Translate Dashboard_SalesToday}" />
                <controls:StatTile Grid.Row="0" Grid.Column="2" x:Name="TotalProductsTile"
                        IconGlyph="{x:Static loc:BootstrapIcons.BoxSeam}"
                        AccentColor="{StaticResource AccentPurple}" AccentSoftColor="{StaticResource AccentPurpleSoft}"
                        Label="{loc:Translate Dashboard_Products}" />
                <controls:StatTile Grid.Row="1" Grid.Column="0" x:Name="LowStockTile"
                        IconGlyph="{x:Static loc:BootstrapIcons.BoxSeam}"
                        AccentColor="{StaticResource AccentAmber}" AccentSoftColor="{StaticResource AccentAmberSoft}"
                        Label="{loc:Translate Dashboard_LowStock}" />
                <controls:StatTile Grid.Row="1" Grid.Column="1" x:Name="OutOfStockTile"
                        IconGlyph="{x:Static loc:BootstrapIcons.BoxSeam}"
                        AccentColor="{StaticResource ErrorColor}" AccentSoftColor="#FCE4E4"
                        Label="{loc:Translate Dashboard_OutOfStock}" />
                <controls:StatTile Grid.Row="1" Grid.Column="2" x:Name="ExpiringSoonTile"
                        IconGlyph="{x:Static loc:BootstrapIcons.ClockHistory}"
                        AccentColor="{StaticResource AccentOrange}" AccentSoftColor="{StaticResource AccentOrangeSoft}"
                        Label="{loc:Translate Dashboard_ExpiringSoon}" />
                <controls:StatTile Grid.Row="2" Grid.Column="0" x:Name="ExpiredTile"
                        IconGlyph="{x:Static loc:BootstrapIcons.Calendar3}"
                        AccentColor="{StaticResource ErrorColor}" AccentSoftColor="#FCE4E4"
                        Label="{loc:Translate Dashboard_Expired}" />
                <controls:StatTile Grid.Row="2" Grid.Column="1" x:Name="ArchivedProductsTile"
                        IconGlyph="{x:Static loc:BootstrapIcons.Archive}"
                        AccentColor="{StaticResource Gray500}" AccentSoftColor="{StaticResource Gray100}"
                        Label="{loc:Translate Dashboard_Archived}" Tapped="OnArchivedCardTapped" />
                <controls:StatTile x:Name="NegativeStockCard" Grid.Row="2" Grid.Column="2" IsVisible="False"
                        IconGlyph="{x:Static loc:BootstrapIcons.BoxSeam}"
                        AccentColor="{StaticResource ErrorColor}" AccentSoftColor="#FCE4E4"
                        Label="{loc:Translate Dashboard_NegativeStock}" />
            </Grid>

            <!-- Trend a raw "today" number can't show: is business up or down
                 this week? ColumnSeries over the last 7 days (including
                 $0 days — see DashboardEndpoints.RevenueTrend). -->
            <Border Style="{StaticResource Card}" Padding="16,14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Dashboard_RevenueTrend}" Style="{StaticResource SectionLabel}" />
                    <toolkit:SfCartesianChart x:Name="RevenueTrendChart" HeightRequest="200">
                        <toolkit:SfCartesianChart.XAxes>
                            <toolkit:CategoryAxis ShowMajorGridLines="False" />
                        </toolkit:SfCartesianChart.XAxes>
                        <toolkit:SfCartesianChart.YAxes>
                            <toolkit:NumericalAxis ShowMajorGridLines="True" />
                        </toolkit:SfCartesianChart.YAxes>
                        <toolkit:ColumnSeries x:Name="RevenueTrendSeries"
                                XBindingPath="DayLabel" YBindingPath="Revenue"
                                Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                CornerRadius="6,6,0,0" />
                    </toolkit:SfCartesianChart>
                </VerticalStackLayout>
            </Border>

            <!-- Stock-health proportion at a glance — complements (doesn't
                 replace) the Low stock/Out of stock number tiles above,
                 which stay as exact counts for "needs action now" scanning. -->
            <Border Style="{StaticResource Card}" Padding="16,14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Dashboard_StockHealth}" Style="{StaticResource SectionLabel}" />
                    <toolkit:SfCircularChart x:Name="StockHealthChart" HeightRequest="220">
                        <toolkit:SfCircularChart.Legend>
                            <toolkit:ChartLegend Placement="Bottom" />
                        </toolkit:SfCircularChart.Legend>
                        <toolkit:DoughnutSeries x:Name="StockHealthSeries"
                                XBindingPath="Label" YBindingPath="Value"
                                ShowDataLabels="True" />
                    </toolkit:SfCircularChart>
                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:Translate Dashboard_RecentSales}" Style="{StaticResource SectionLabel}" />
            <Label x:Name="NoRecentSalesLabel" Text="{loc:Translate Dashboard_NoRecentSales}" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
            <CollectionView x:Name="RecentSalesView" IsVisible="False">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FieldBorder}" HeightRequest="-1" Padding="12,8" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding TimeText}" FontAttributes="Bold" />
                                    <Label Text="{Binding PaymentMethodText}" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                                    <Label Text="{Binding ItemsSummaryText}" Style="{StaticResource PageSubtitle}" FontSize="12" LineBreakMode="TailTruncation" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding TotalText}" VerticalOptions="Center" FontAttributes="Bold" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
