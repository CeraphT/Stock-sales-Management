<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.SupplierEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PharmaStock.Desktop.Controls"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    Title="{loc:Translate SupplierEdit_Title}">

    <ScrollView>
        <Grid Padding="24">
            <Border Style="{StaticResource Card}" MaximumWidthRequest="480" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Label x:Name="HeaderLabel" Style="{StaticResource PageTitle}" />

                    <controls:FormField x:Name="NameField" Label="{loc:Translate SupplierEdit_NameLabel}" Placeholder="{loc:Translate SupplierEdit_NamePlaceholder}" />
                    <controls:FormField x:Name="PhoneField" Label="{loc:Translate SupplierEdit_PhoneLabel}" Placeholder="ex. 677001122" Keyboard="Telephone" />
                    <controls:FormField x:Name="EmailField" Label="{loc:Translate SupplierEdit_EmailLabel}" Placeholder="ex. contact@fournisseur.com" Keyboard="Email" />

                    <controls:IconButton x:Name="SaveButton" Icon="{x:Static loc:BootstrapIcons.Check2}" Text="{loc:Translate SupplierEdit_Save}" Clicked="OnSaveClicked" Margin="0,10,0,0" />
                    <controls:IconButton Icon="{x:Static loc:BootstrapIcons.XLg}" Text="{loc:Translate Common_Cancel}" Variant="Secondary" Clicked="OnCancelClicked" />
                    <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
