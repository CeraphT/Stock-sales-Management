<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.CashRegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PharmaStock.Desktop.Controls"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    Title="{loc:Translate Shift_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Label Text="{loc:Translate Shift_Title}" Style="{StaticResource PageTitle}" HorizontalOptions="Start" />

            <ActivityIndicator x:Name="LoadingSpinner" IsRunning="False" IsVisible="False" HorizontalOptions="Center" Margin="0,20,0,0" />

            <!-- No shift currently open at this location -->
            <Border x:Name="OpenShiftCard" Style="{StaticResource Card}" IsVisible="False">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{loc:Translate Shift_NoOpenShift}" Style="{StaticResource SectionLabel}" />
                    <controls:FormField x:Name="OpeningCashField" Label="{loc:Translate Shift_OpeningAmountLabel}" Placeholder="0" Keyboard="Numeric" />
                    <controls:IconButton x:Name="OpenShiftButton" Icon="{x:Static loc:BootstrapIcons.Check2}" Text="{loc:Translate Shift_OpenAction}" Clicked="OnOpenShiftClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- A shift is currently open -->
            <Border x:Name="ActiveShiftCard" Style="{StaticResource Card}" IsVisible="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate Shift_ActiveTitle}" Style="{StaticResource SectionLabel}" TextColor="{StaticResource SuccessColor}" />
                    <Label x:Name="OpenedInfoLabel" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10" Margin="0,6,0,0">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                            <Label x:Name="OpeningAmountLabel" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{loc:Translate Shift_OpeningAmountLabel}" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                            <Label x:Name="SalesCountLabel" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{loc:Translate Shift_SalesCount}" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                            <Label x:Name="TotalSalesLabel" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{loc:Translate Shift_TotalSales}" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                            <Label x:Name="ExpectedCashLabel" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{loc:Translate Shift_ExpectedCash}" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                        </VerticalStackLayout>
                    </Grid>

                    <controls:IconButton x:Name="CloseShiftToggleButton" Icon="{x:Static loc:BootstrapIcons.Lock}" Text="{loc:Translate Shift_CloseAction}" Variant="Secondary" Clicked="OnCloseToggleClicked" Margin="0,10,0,0" />

                    <VerticalStackLayout x:Name="ClosePanel" IsVisible="False" Spacing="10" Margin="0,6,0,0">
                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />
                        <controls:FormField x:Name="ClosingCashField" Label="{loc:Translate Shift_ClosingAmountLabel}" Placeholder="0" Keyboard="Numeric" />
                        <controls:FormField x:Name="ClosingNotesField" Label="{loc:Translate Shift_NotesLabel}" Placeholder="{loc:Translate Shift_NotesPlaceholder}" />
                        <controls:IconButton x:Name="ConfirmCloseButton" Icon="{x:Static loc:BootstrapIcons.Check2}" Text="{loc:Translate Shift_ConfirmClose}" Clicked="OnConfirmCloseClicked" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:Translate Shift_History}" Style="{StaticResource SectionLabel}" />
            <Label x:Name="EmptyHistoryLabel" Text="{loc:Translate Shift_NoHistory}" Style="{StaticResource PageSubtitle}" IsVisible="False" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
            <CollectionView x:Name="HistoryView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,6">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding DateRangeText}" FontAttributes="Bold" />
                                <Label Text="{Binding OpenedByText}" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                                <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding OpeningText}" FontAttributes="Bold" FontSize="14" />
                                        <Label Text="{loc:Translate Shift_OpeningAmountShort}" Style="{StaticResource PageSubtitle}" FontSize="11" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding ClosingText}" FontAttributes="Bold" FontSize="14" />
                                        <Label Text="{loc:Translate Shift_ClosingAmountShort}" Style="{StaticResource PageSubtitle}" FontSize="11" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2">
                                        <Label Text="{Binding DiscrepancyText}" TextColor="{Binding DiscrepancyColor}" FontAttributes="Bold" FontSize="14" />
                                        <Label Text="{loc:Translate Shift_DiscrepancyShort}" Style="{StaticResource PageSubtitle}" FontSize="11" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <controls:IconButton x:Name="LoadMoreButton" Icon="{x:Static loc:BootstrapIcons.ChevronDown}" Text="{loc:Translate Common_LoadMore}" Variant="Secondary" Clicked="OnLoadMoreClicked" IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
