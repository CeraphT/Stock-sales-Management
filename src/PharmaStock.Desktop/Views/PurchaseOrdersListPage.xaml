<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.PurchaseOrdersListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    Title="{loc:Translate Shell_PurchaseOrders}">

    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label Grid.Column="0" Text="{loc:Translate Shell_PurchaseOrders}" Style="{StaticResource PageTitle}" HorizontalOptions="Start" VerticalOptions="Center" />
            <Button Grid.Column="1" x:Name="NewButton" Text="&#xF64D;" FontFamily="BootstrapIcons" Style="{StaticResource SecondaryButton}" FontSize="20" Padding="0" WidthRequest="46" HeightRequest="46" Clicked="OnNewClicked" SemanticProperties.Hint="{loc:Translate PurchaseOrder_New}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0" x:Name="AllChip" Text="{loc:Translate SalesHistory_All}" Style="{StaticResource ChipButtonSelected}" FontSize="11" Padding="2,10" Clicked="OnAllClicked" />
            <Button Grid.Column="1" x:Name="PendingChip" Text="{loc:Translate PurchaseOrder_StatusPending}" Style="{StaticResource ChipButtonUnselected}" FontSize="11" Padding="2,10" Clicked="OnPendingClicked" />
            <Button Grid.Column="2" x:Name="PartialChip" Text="{loc:Translate PurchaseOrder_StatusPartial}" Style="{StaticResource ChipButtonUnselected}" FontSize="11" Padding="2,10" Clicked="OnPartialClicked" />
            <Button Grid.Column="3" x:Name="ReceivedChip" Text="{loc:Translate PurchaseOrder_StatusReceived}" Style="{StaticResource ChipButtonUnselected}" FontSize="11" Padding="2,10" Clicked="OnReceivedClicked" />
            <Button Grid.Column="4" x:Name="CancelledChip" Text="{loc:Translate PurchaseOrder_StatusCancelled}" Style="{StaticResource ChipButtonUnselected}" FontSize="11" Padding="2,10" Clicked="OnCancelledClicked" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button Grid.Column="0" x:Name="SupplierFilterButton" Text="{loc:Translate PurchaseOrder_SupplierFilterAll}" Style="{StaticResource SecondaryButton}" HorizontalOptions="Fill" FontSize="13" Clicked="OnSupplierFilterClicked" />
            <Button Grid.Column="1" x:Name="ClearSupplierFilterButton" Text="&#xF659;" FontFamily="BootstrapIcons" Style="{StaticResource SecondaryButton}" Padding="0" WidthRequest="46" IsVisible="False" Clicked="OnClearSupplierFilterClicked" />
        </Grid>

        <Grid Grid.Row="3">
            <CollectionView x:Name="OrdersView" SelectionMode="Single" SelectionChanged="OnOrderSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,6">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding SupplierName}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding SubtitleText}" Style="{StaticResource PageSubtitle}" HorizontalOptions="Start" HorizontalTextAlignment="Start" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="EmptyLabel" Text="{loc:Translate PurchaseOrder_Empty}" Style="{StaticResource PageSubtitle}" IsVisible="False" VerticalOptions="Start" />

            <ActivityIndicator x:Name="LoadingSpinner" IsRunning="False" IsVisible="False" VerticalOptions="Start" Margin="0,24,0,0" />
        </Grid>

    </Grid>
</ContentPage>
