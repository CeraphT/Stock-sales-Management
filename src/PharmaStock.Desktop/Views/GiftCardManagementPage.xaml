<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PharmaStock.Desktop.Views.GiftCardManagementPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PharmaStock.Desktop.Controls"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    Title="{loc:Translate Shell_GiftCards}">

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="{loc:Translate Shell_GiftCards}" Style="{StaticResource PageTitle}" HorizontalOptions="Start" />
                <Button Grid.Column="1" Text="&#xF64D;" FontFamily="BootstrapIcons" WidthRequest="46" Padding="0" Clicked="OnIssueGiftCardClicked" />
            </Grid>
            <controls:CollapsibleSearchBar x:Name="SearchBarControl" Placeholder="{loc:Translate GiftCardManagement_SearchPlaceholder}" TextChanged="OnSearchTextChanged" />
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <CollectionView x:Name="GiftCardsView" SelectionMode="Single" SelectionChanged="OnGiftCardSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FieldBorder}" HeightRequest="-1" Padding="12,10" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Code}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding BalanceText}" Style="{StaticResource PageSubtitle}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" BackgroundColor="{Binding StatusColor}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,2" VerticalOptions="Center">
                                    <Label Text="{Binding StatusText}" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="EmptyLabel" Text="{loc:Translate GiftCardManagement_Empty}" Style="{StaticResource PageSubtitle}" IsVisible="False" VerticalOptions="Start" />

            <ActivityIndicator x:Name="LoadingSpinner" IsRunning="False" IsVisible="False" VerticalOptions="Start" Margin="0,24,0,0" />
        </Grid>

    </Grid>
</ContentPage>
