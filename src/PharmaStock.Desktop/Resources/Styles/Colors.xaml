<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- PharmaStock palette: a pharmacy-green primary rather than MAUI's
         default template purple, plus a small set of semantic colors
         (Background/Surface/TextPrimary/TextSecondary/Border/Error/Success)
         used by the Card/FieldLabel/etc. styles below. The old Secondary/
         Tertiary/Magenta/MidnightBlue keys are kept, still referenced by a
         few of the template's original Shell/TabbedPage styles further down. -->
    <Color x:Key="Primary">#1E8A6E</Color>
    <Color x:Key="PrimaryDark">#5FBFA3</Color>
    <Color x:Key="PrimaryDarkText">#0B2B22</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="Background">#F5F8F7</Color>
    <Color x:Key="Surface">White</Color>
    <Color x:Key="TextPrimary">#1F2937</Color>
    <Color x:Key="TextSecondary">#6B7280</Color>
    <Color x:Key="BorderColor">#E3E7E5</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>

    <!-- Vibrant-retail accent set: a solid + soft-tint pair per accent, for
         the "icon in a colored circle" stat-tile badges and colored status
         pills. AccentAmber specifically replaces low-stock's old plain-gray
         treatment (ProductCatalogPage/PosPage), which read as "disabled"
         rather than "needs attention". -->
    <Color x:Key="AccentBlue">#2563EB</Color>
    <Color x:Key="AccentBlueSoft">#DBEAFE</Color>
    <Color x:Key="AccentPurple">#7C3AED</Color>
    <Color x:Key="AccentPurpleSoft">#EDE3FC</Color>
    <Color x:Key="AccentAmber">#D97706</Color>
    <Color x:Key="AccentAmberSoft">#FEF3C7</Color>
    <Color x:Key="AccentOrange">#EA580C</Color>
    <Color x:Key="AccentOrangeSoft">#FFE4D5</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#14181A</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>