<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android is now the primary target: shop staff will mostly use an
		     Android tablet, not a PC (better battery resilience through
		     power outages, cheaper/more repairable hardware locally). Windows
		     stays as a secondary target for businesses that already own a PC.
		     iOS is deliberately not targeted yet — building/signing an iOS
		     app requires a Mac (or a cloud Mac CI runner), which isn't set up. -->
		<TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>PharmaStock.Desktop</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name (shown as the Android app label / Windows window title) -->
		<ApplicationTitle>PharmaStock</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.pharmastock.app</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1F4E5F" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F4E5F" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- Camera barcode scanning for the POS screen. Windows decode is not
		     supported by this package (generation only) — the manual/HID
		     scanner text entry field on PosPage covers Windows instead. -->
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.3" />
		<!-- Legacy codepages (CP850) for ESC/POS receipt-printer text encoding —
		     .NET no longer includes these by default (see ReceiptFormatter). -->
		<PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
		<!-- Local offline-first database (Section 6) — same PharmaStockDbContext
		     as the server, pointed at a local file instead of Postgres. -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.29" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<!-- Microsoft.EntityFrameworkCore.Sqlite's floor pulls SQLitePCLRaw
		     2.1.6, which has a known high-severity advisory (GHSA-2m69-gcr7-jv3q)
		     — pin the bundle directly to a patched release. -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
		<!-- Styled .xlsx export (Rapports, Ventes en attente) — pure managed,
		     no System.Drawing dependency, so it works on Android as well as
		     Windows. -->
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
		<!-- Open-source (MIT, no licensing fee ever — chosen deliberately over
		     Syncfusion's paid Essential Studio since this app is meant to be
		     resold) UI controls for the redesign: numeric steppers, date
		     pickers, charts (Reports), pull-to-refresh, shimmer loading. -->
		<PackageReference Include="Syncfusion.Maui.Toolkit" Version="1.0.10" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PharmaStock.Domain\PharmaStock.Domain.csproj" />
		<ProjectReference Include="..\PharmaStock.Infrastructure\PharmaStock.Infrastructure.csproj" />
	</ItemGroup>

</Project>
