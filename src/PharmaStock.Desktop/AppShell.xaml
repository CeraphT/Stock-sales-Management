<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PharmaStock.Desktop.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PharmaStock.Desktop.Views"
    Title="PharmaStock"
    FlyoutBehavior="Disabled">

    <!-- Onboarding and Dashboard each get their own FlyoutItem (even though
         the flyout itself is disabled) so they're both valid absolute
         navigation targets ("//OnboardingPage", "//DashboardPage") without
         being grouped into an implicit tab bar, which is what happens if
         multiple ShellContent sit directly under one FlyoutItem/Shell. -->
    <FlyoutItem Title="Welcome" Route="OnboardingSection">
        <ShellContent
            ContentTemplate="{DataTemplate views:OnboardingPage}"
            Route="OnboardingPage" />
    </FlyoutItem>

    <FlyoutItem Title="Dashboard" Route="DashboardSection">
        <ShellContent
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Route="DashboardPage" />
    </FlyoutItem>

</Shell>
