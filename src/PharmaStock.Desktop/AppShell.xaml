<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PharmaStock.Desktop.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PharmaStock.Desktop.Views"
    xmlns:loc="clr-namespace:PharmaStock.Desktop.Services"
    Title="PharmaStock"
    FlyoutBehavior="Flyout">

    <!-- Every top-level page gets its own FlyoutItem so each is a valid
         absolute navigation target ("//DashboardPage", etc.) without being
         grouped into an implicit tab bar, which is what happens if multiple
         ShellContent sit directly under one FlyoutItem/Shell. Every item
         below uses Shell.FlyoutItemIsVisible="False" (not IsVisible!) — that
         attached property only hides it from the auto-rendered flyout list;
         the base VisualElement IsVisible instead drops the item from Shell's
         route table entirely and broke GoToAsync in the past ("unable to
         figure out route for: //OnboardingSection/..."). The actual visible
         flyout UI (header + collapsible grouped sections) is built in
         AppShell.xaml.cs's constructor via Shell.FlyoutHeader/FlyoutContent,
         navigating with GoToAsync against these same routes — hiding an item
         here does not affect that. -->
    <FlyoutItem Title="Bienvenue" Route="OnboardingSection" Shell.FlyoutItemIsVisible="False">
        <ShellContent
            ContentTemplate="{DataTemplate views:OnboardingPage}"
            Route="OnboardingPage" />
    </FlyoutItem>

    <FlyoutItem Title="{loc:Translate Shell_Dashboard}" Route="DashboardSection" Shell.FlyoutItemIsVisible="False">
        <ShellContent
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Route="DashboardPage" />
    </FlyoutItem>

    <FlyoutItem Title="{loc:Translate Shell_Pos}" Route="PosSection" Shell.FlyoutItemIsVisible="False">
        <ShellContent
            ContentTemplate="{DataTemplate views:PosPage}"
            Route="PosPage" />
    </FlyoutItem>

    <FlyoutItem Title="{loc:Translate Shell_CashRegister}" Route="CashRegisterSection" Shell.FlyoutItemIsVisible="False">
        <ShellContent
            ContentTemplate="{DataTemplate views:CashRegisterPage}"
            Route="CashRegisterPage" />
    </FlyoutItem>

    <FlyoutItem Title="{loc:Translate Shell_Products}" Route="ProductCatalogSection" Shell.FlyoutItemIsVisible="False">
        <ShellContent
            ContentTemplate="{DataTemplate views:ProductCatalogPage}"
            Route="ProductCatalogPage" />
    </FlyoutItem>

    <FlyoutItem Title="{loc:Translate Shell_Categories}" Route="CategoryManagementSection" Shell.FlyoutItemIsVisible="False">
        <ShellContent
            ContentTemplate="{DataTemplate views:CategoryManagementPage}"
            Route="CategoryManagementPage" />
    </FlyoutItem>

    <FlyoutItem Title="{loc:Translate Shell_Archives}" Route="ArchivedProductsSection" Shell.FlyoutItemIsVisible="False">
        <ShellContent
            ContentTemplate="{DataTemplate views:ArchivedProductsPage}"
            Route="ArchivedProductsPage" />
    </FlyoutItem>

    <FlyoutItem Title="{loc:Translate Shell_Suppliers}" Route="SupplierManagementSection" Shell.FlyoutItemIsVisible="False">
        <ShellContent
            ContentTemplate="{DataTemplate views:SupplierManagementPage}"
            Route="SupplierManagementPage" />
    </FlyoutItem>

    <FlyoutItem Title="{loc:Translate Shell_PurchaseOrders}" Route="PurchaseOrdersSection" Shell.FlyoutItemIsVisible="False">
        <ShellContent
            ContentTemplate="{DataTemplate views:PurchaseOrdersListPage}"
            Route="PurchaseOrdersListPage" />
    </FlyoutItem>

    <FlyoutItem Title="{loc:Translate Shell_Customers}" Route="CustomerManagementSection" Shell.FlyoutItemIsVisible="False">
        <ShellContent
            ContentTemplate="{DataTemplate views:CustomerManagementPage}"
            Route="CustomerManagementPage" />
    </FlyoutItem>

    <FlyoutItem Title="{loc:Translate Shell_GiftCards}" Route="GiftCardManagementSection" Shell.FlyoutItemIsVisible="False">
        <ShellContent
            ContentTemplate="{DataTemplate views:GiftCardManagementPage}"
            Route="GiftCardManagementPage" />
    </FlyoutItem>

    <FlyoutItem Title="{loc:Translate Shell_SalesHistory}" Route="SalesHistorySection" Shell.FlyoutItemIsVisible="False">
        <ShellContent
            ContentTemplate="{DataTemplate views:SalesHistoryPage}"
            Route="SalesHistoryPage" />
    </FlyoutItem>

    <FlyoutItem Title="{loc:Translate Shell_HeldSales}" Route="HeldSalesHistorySection" Shell.FlyoutItemIsVisible="False">
        <ShellContent
            ContentTemplate="{DataTemplate views:HeldSalesHistoryPage}"
            Route="HeldSalesHistoryPage" />
    </FlyoutItem>

    <FlyoutItem Title="{loc:Translate Shell_Reports}" Route="ReportsSection" Shell.FlyoutItemIsVisible="False">
        <ShellContent
            ContentTemplate="{DataTemplate views:ReportsPage}"
            Route="ReportsPage" />
    </FlyoutItem>

    <FlyoutItem Title="{loc:Translate Shell_PrinterSettings}" Route="PrinterSettingsSection" Shell.FlyoutItemIsVisible="False">
        <ShellContent
            ContentTemplate="{DataTemplate views:PrinterSettingsPage}"
            Route="PrinterSettingsPage" />
    </FlyoutItem>

    <FlyoutItem Title="{loc:Translate Shell_CompanySettings}" Route="CompanySettingsSection" Shell.FlyoutItemIsVisible="False">
        <ShellContent
            ContentTemplate="{DataTemplate views:CompanySettingsPage}"
            Route="CompanySettingsPage" />
    </FlyoutItem>

</Shell>
